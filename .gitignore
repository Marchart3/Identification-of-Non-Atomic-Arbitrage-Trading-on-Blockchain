# 忽略所有日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 忽略依赖目录
node_modules/
vendor/
env/
venv/
.venv/

# 忽略编译产物
*.pyc
*.pyo
*.exe
*.out
*.so
*.class

# 忽略操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini

# 忽略 IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 忽略环境变量文件 (非常重要！)
.env
.env.local
.env.*.local

# 忽略临时文件
tmp/
temp/
